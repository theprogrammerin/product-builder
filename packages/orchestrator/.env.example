# Same GLM config as packages/llm-client — copy to .env and fill in.
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_API_KEY=
GLM_MODEL=glm-4.6
GLM_TIMEOUT_MS=60000
GLM_MAX_RETRIES=2

# Orchestrator-specific
PORT=4000

# Root directory where each project's scaffolded codebase is written
# (one subdirectory per project id). Relative paths resolve against the
# orchestrator process's cwd.
PROJECT_FILES_DIR=./generated-projects
