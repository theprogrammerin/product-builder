# GLM endpoint configuration — copy to .env and fill in.
# Points the LLM Client at Zhipu's hosted GLM API by default; change
# GLM_BASE_URL to point at a self-hosted or otherwise GLM-compatible
# endpoint instead.

GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_API_KEY=
GLM_MODEL=glm-4.6

# Optional — defaults shown
GLM_TIMEOUT_MS=60000
GLM_MAX_RETRIES=2
